@* The document shell for one Drupal-resolved page — the counterpart of the
   Astro template's Layout: document head from the Canvas content API's
   Unhead-shaped data, the rendered component tree, and the draft session
   banner. *@
<!DOCTYPE html>
<html lang="en" class="h-full antialiased">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>@(Page?.Head.Title ?? "Not found")</title>
    @if (Page?.Head.Meta is { } metaTags)
    {
        foreach (var meta in metaTags)
        {
            <meta @attributes="ToAttributes(meta)" />
        }
    }
    @if (Page?.Head.Link is { } linkTags)
    {
        foreach (var link in linkTags)
        {
            <link @attributes="ToAttributes(link)" />
        }
    }
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="flex min-h-full flex-col">
    <DraftBanner />
    @if (Page is { } page)
    {
        <CanvasComponentTree Tree="page.Content" />
    }
    else
    {
        <main class="mx-auto w-full max-w-2xl px-6 py-10">
            <p class="mb-6">
                <a href="/" class="text-sm underline">← Back to home</a>
            </p>
            <h1 class="mb-2 text-3xl font-bold">Not found</h1>
            <p class="text-sm text-gray-500">
                Drupal answered nothing for <code class="rounded bg-gray-100 px-1">@Path</code>.
            </p>
        </main>
    }
</body>
</html>

@code {
    [Parameter]
    public Page? Page { get; set; }

    [Parameter]
    public string Path { get; set; } = "/";

    private static Dictionary<string, object> ToAttributes(IReadOnlyDictionary<string, string> attributes)
        => attributes.ToDictionary(pair => pair.Key, pair => (object)pair.Value);
}
